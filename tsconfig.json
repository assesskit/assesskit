{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@assesskit/runtime": ["./packages/runtime/src/index.ts"],
      "@assesskit/runtime/checks": ["./packages/runtime/src/checks.ts"],
      "@assesskit/runtime/errors": ["./packages/runtime/src/errors.ts"],
      "@assesskit/runtime/delivery/wire": ["./packages/runtime/src/delivery/wire.ts"],
      "@assesskit/runtime/*": ["./packages/runtime/src/*/index.ts"]
    }
  },
  "include": ["docs/*.ts", "scripts", "vitest.config.ts"]
}
