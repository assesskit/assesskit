{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/runtime": {
      "entry": ["src/index.ts", "src/*/index.ts", "src/cli/bin.ts"]
    },
    "packages/player": {
      "entry": [
        "src/index.ts",
        "src/*/index.ts",
        "src/cat/measurekit/index.ts",
        "src/player/pci/frame/bridge.ts",
        "src/player/recording/worklet/recorder-worklet.ts"
      ],
      "ignore": ["test/fixtures/**"],
      "ignoreDependencies": ["requirejs", "mathjax"]
    },
    "compat": {
      "entry": ["smoke.ts"],
      "ignoreDependencies": ["stylelint-no-unsupported-browser-features", "playwright-core"]
    },
    "compat/engines/*": {
      "entry": ["playwright.config.ts"],
      "playwright": false
    }
  }
}
