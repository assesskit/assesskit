{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/olah": {
      "entry": ["src/index.ts", "src/*/index.ts"]
    },
    "packages/tempuh": {
      "entry": ["src/index.ts", "src/*/index.ts", "src/player/pci/frame/bridge.ts"],
      "ignore": ["test/fixtures/**"],
      "ignoreDependencies": ["requirejs", "mathjax"]
    },
    "compat": {
      "entry": ["smoke.ts"],
      "ignoreDependencies": ["stylelint-no-unsupported-browser-features", "playwright-core"]
    },
    "compat/engines/*": {
      "entry": ["playwright.config.ts"],
      "playwright": false
    }
  }
}
