{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/peak-memory-child.ts"],
      "ignoreDependencies": ["jscpd"]
    },
    "packages/runtime": {
      "entry": ["src/index.ts", "src/checks.ts", "src/*/index.ts", "src/delivery/wire.ts", "src/cli/bin.ts"],
      "ignore": ["src/node/schema-files.d.json.ts"]
    },
    "packages/player": {
      "entry": [
        "src/index.ts",
        "src/*/index.ts",
        "src/client/local/index.ts",
        "src/player/pci/frame/bridge.ts",
        "src/player/recording/worklet/recorder-worklet.ts"
      ],
      "ignore": ["test/fixtures/**"],
      "ignoreDependencies": ["requirejs", "mathjax"]
    },
    "packages/custom-interactions": {
      "entry": ["src/index.ts", "src/node/index.ts", "src/*/module.ts"]
    },
    "examples/*/*": {
      "entry": ["src/index.ts"]
    },
    "compat": {
      "entry": ["smoke.ts"],
      "ignoreDependencies": ["stylelint-no-unsupported-browser-features"]
    },
    "compat/runtimes": {
      "entry": ["run.ts", "worker.ts"],
      "ignoreDependencies": ["workerd"]
    },
    "compat/engines/*": {
      "entry": ["playwright.config.ts"],
      "playwright": false
    }
  }
}
