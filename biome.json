{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/CHANGELOG.md",
      "!docs/api",
      "!**/test/fixtures",
      "!scripts/corpus.lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js"
            }
          }
        }
      },
      "style": {
        "noDefaultExport": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "typeParameter"
                },
                "match": "T(?:[A-Z][a-zA-Z]*)?",
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/runtime/src/**"],
      "linter": {
        "rules": {
          "security": {
            "noGlobalEval": "error"
          }
        }
      },
      "plugins": ["./biome/no-math-random.grit", "./biome/no-clock.grit", "./biome/no-regexp-constructor.grit"]
    },
    {
      "includes": ["packages/runtime/src/**", "!packages/runtime/src/node/**", "!packages/runtime/src/cli/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noProcessEnv": "error",
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "XMLHttpRequest": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "WebSocket": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "window": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "document": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "process": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "setTimeout": "The runtime core uses no platform API; only node/ and cli/ may.",
                  "setInterval": "The runtime core uses no platform API; only node/ and cli/ may."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/runtime/src/errors.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*", "./*/**"],
                    "message": "errors.ts depends on nothing."
                  },
                  {
                    "group": ["@assesskit/player", "@assesskit/player/**"],
                    "message": "The runtime is the lower package: it never imports the player."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/runtime/src/checks.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*", "./*/**", "!./errors.js"],
                    "message": "checks.ts depends only on errors.ts."
                  },
                  {
                    "group": ["@assesskit/player", "@assesskit/player/**"],
                    "message": "The runtime is the lower package: it never imports the player."
                  }
                ]
              }
            }
          }
        }
