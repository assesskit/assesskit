{
  "name": "assesskit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project '!*-corpus*' --project '!*-xsd' --project '!*-browser*' --project '!*-bench'",
    "test:coverage": "vitest run --coverage --project '!*-corpus*' --project '!*-xsd' --project '!*-browser*' --project '!*-bench'",
    "bench": "pnpm -r bench",
    "test:browser": "vitest run --project '*-browser*'",
    "test:coverage:browser": "COVERAGE_RUN=browser BROWSERS=chromium vitest run --coverage --project player-browser",
    "test:corpus": "vitest run --project '*-corpus*'",
    "test:xsd": "vitest run --project '*-xsd'",
    "lint": "biome check . && cspell --no-progress",
    "check:standards": "node scripts/check-standards.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:audit": "pnpm audit --prod && pnpm audit --audit-level=high",
    "check:tarballs": "pnpm build && node scripts/check-tarballs.ts",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "pnpm build && typedoc && node scripts/self-host-mermaid.ts",
    "check:packages": "pnpm -r check:packages",
    "check:release": "node scripts/check-release.ts",
    "compat": "pnpm build && node compat/check.ts",
    "compat:engines": "pnpm build && node compat/run-engines.ts",
    "corpus": "node scripts/corpus.ts fetch",
    "corpus:pin": "node scripts/corpus.ts pin",
    "schemas": "node scripts/schemas.ts fetch",
    "schemas:pin": "node scripts/schemas.ts pin",
    "conformance": "pnpm build && node scripts/conformance.ts run",
    "conformance:pin": "node scripts/conformance.ts pin && biome format --write scripts/conformance-features.json",
    "unicode": "node scripts/unicode.ts",
    "asi-table": "node scripts/asi-table.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "mermaid": "11.17.2",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "saxes": "6.0.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-mermaid": "1.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0"
}
