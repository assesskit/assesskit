{
  "name": "olah-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project '!*-corpus*' --project '!*-xsd' --project '!*-browser*' --project '!differential*'",
    "bench": "pnpm -r bench",
    "test:browser": "vitest run --project '*-browser*'",
    "test:corpus": "vitest run --project '*-corpus*' --project '!differential*'",
    "test:differential": "vitest run --project 'differential*'",
    "test:xsd": "vitest run --project '*-xsd'",
    "lint": "biome check . && cspell --no-progress",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "typedoc",
    "check:packages": "pnpm -r check:packages",
    "conformance": "node conformance/check.ts",
    "conformance:render": "node conformance/render.ts",
    "compat": "node compat/check.ts",
    "compat:engines": "node compat/run-engines.ts",
    "corpus": "node scripts/corpus.ts fetch",
    "corpus:pin": "node scripts/corpus.ts pin",
    "schemas": "node scripts/schemas.ts fetch",
    "schemas:pin": "node scripts/schemas.ts pin",
    "unicode": "node scripts/unicode.ts",
    "asi-table": "node scripts/asi-table.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "cspell": "^10.4.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "saxes": "6.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
