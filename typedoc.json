{
  "$schema": "https://typedoc.org/schema.json",
  "name": "assesskit",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/runtime", "packages/player", "packages/custom-interactions"],
  "readme": "README.md",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-mermaid", "./docs/typedoc-seo.ts"],
  "treatWarningsAsErrors": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "tsx",
    "typescript",
    "xml",
    "yaml"
  ]
}
