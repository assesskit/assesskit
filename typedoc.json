{
  "$schema": "https://typedoc.org/schema.json",
  "name": "olah",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/olah", "packages/tempuh"],
  "readme": "README.md",
  "out": "docs/api",
  "treatWarningsAsErrors": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "tsx",
    "typescript",
    "xml",
    "yaml"
  ]
}
