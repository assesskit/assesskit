{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "files": [
    "packages/*/src/**",
    "packages/*/test/*.ts",
    "packages/*/README.md",
    "packages/*/docs/*.md",
    "differential/**",
    "scripts/*",
    "validation/*",
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "conformance/*.ts",
    "conformance/test/*.ts"
  ],
  "words": [
    "aeiou",
    "apos",
    "Bahasa",
    "Blackman",
    "BPIG",
    "finalizer",
    "Greekand",
    "imslticc",
    "imsmanifest",
    "letrec",
    "lolz",
    "Longsight",
    "longsightgroup",
    "luthfanwakan",
    "mathml",
    "multiset",
    "olah",
    "opentag",
    "opentagstart",
    "prec",
    "processinginstruction",
    "qtiv",
    "rtest",
    "scaleb",
    "SSML",
    "subpaths",
    "takar",
    "tempuh",
    "Vigna",
    "xinclude",
    "xlink",
    "xmlchars",
    "xmldecl",
    "xoshiro",
    "xpointer",
    "xsdtests"
  ],
  "ignorePaths": [
    "packages/olah/docs/conformance.md",
    "packages/olah/src/values/unicode-blocks.ts",
    "packages/olah/src/values/unicode-categories.ts"
  ],
  "ignoreRegExpList": ["[A-Za-z0-9_-]+\\.xsd\\b"]
}
