or {
  JsImport() as $import where {
    $import <: r"(?s)^import\b.*[\"']@assesskit/runtime/delivery[\"'].*",
    not $import <: r"(?s)^import\s+type\b.*",
    not $import <: r"(?s)^import\s*\{\s*type\s+\w+(?:\s+as\s+\w+)?(?:\s*,\s*type\s+\w+(?:\s+as\s+\w+)?)*\s*,?\s*\}\s*from\b.*",
    register_diagnostic(span=$import, message="Browser code imports from @assesskit/runtime/delivery only types: the engine holds the answer keys and never ships to a candidate, and the wire forms of views and actions are in @assesskit/runtime/delivery/wire, which reaches no file of the engine.", severity="error")
  },
  JsExport() as $export where {
    $export <: r"(?s)^export\b[^;=]*\bfrom\s*[\"']@assesskit/runtime/delivery[\"'].*",
    not $export <: r"(?s)^export\s+type\b.*",
    register_diagnostic(span=$export, message="Browser code re-exports from @assesskit/runtime/delivery only types: the engine holds the answer keys and never ships to a candidate.", severity="error")
  },
  JsImportCallExpression() as $call where {
    $call <: r"(?s).*@assesskit/runtime/delivery.*",
    not $filename <: r".*client/local/session\.ts$",
    register_diagnostic(span=$call, message="Only client/local/session.ts loads @assesskit/runtime/delivery with import(): practice mode is the one place where the engine reaches a device.", severity="error")
  }
}
