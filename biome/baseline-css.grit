language css

or {
  or {
    CssAttributeSelector() as $selector where { $selector <: r"(?i).*popover.*" },
    CssPseudoClassSelector() as $selector where { $selector <: r"(?i)^:popover-open.*" }
  } as $found where {
    register_diagnostic(span=$found, message="The Popover API: outside the browser baseline (see docs/player/baseline.md). Use a dialog, or an element that script positions.", severity="error")
  },
  or {
    CssNestedQualifiedRule(),
    CssQualifiedRule() as $rule where { $rule <: contains CssAtRule() }
  } as $found where {
    register_diagnostic(span=$found, message="CSS nesting: outside the browser baseline (see docs/player/baseline.md). Use flat selectors.", severity="error")
  },
  CssPseudoClassSelector() as $found where {
    $found <: r"(?is)^:has\(.*",
    register_diagnostic(span=$found, message="The :has() selector: outside the browser baseline (see docs/player/baseline.md). Use a class that script sets.", severity="error")
  },
  or {
    CssScopeAtRule(),
    CssDeclaration() as $declaration where {
      $declaration <: r"(?is)^(?:anchor-name|position-anchor|position-area|anchor-scope)\s*:.*|^text-wrap(?:-style)?\s*:\s*balance.*|^grid-template-(?:columns|rows)\s*:\s*subgrid.*|.*anchor(?:-size)?\(.*"
    }
  } as $found where {
    register_diagnostic(span=$found, message="CSS @scope, anchor positioning, text-wrap: balance and subgrid: outside the browser baseline (see docs/player/baseline.md). Use a shadow root to scope styles, script to position elements, and plain wrapping and grids.", severity="error")
  },
  or {
    CssStartingStyleAtRule(),
    CssDeclaration() as $declaration where { $declaration <: r"(?is)^text-wrap(?:-style)?\s*:\s*pretty.*" }
  } as $found where {
    register_diagnostic(span=$found, message="text-wrap: pretty and @starting-style: outside the browser baseline (see docs/player/baseline.md). Use plain wrapping, and transitions without entry styles.", severity="error")
  }
}
