{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/player/index.ts", "src/protocol/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/luthfanwakan/olah/blob/{gitRevision}/packages/tempuh/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["docs/*.md"],
  "treatWarningsAsErrors": true
}
