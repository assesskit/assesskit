{
  "name": "@luthfanwakan/tempuh",
  "version": "0.0.0",
  "private": true,
  "description": "The player for QTI 3.0 content built on olah: rendering, the PCI host, accessibility in the UI and the server-side integrations.",
  "keywords": [
    "qti",
    "qti3",
    "1edtech",
    "assessment",
    "player",
    "lti",
    "accessibility"
  ],
  "author": "Fariz Wakan (https://github.com/luthfanwakan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luthfanwakan/olah.git",
    "directory": "packages/tempuh"
  },
  "homepage": "https://github.com/luthfanwakan/olah#readme",
  "bugs": "https://github.com/luthfanwakan/olah/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./cat": {
      "types": "./dist/cat/index.d.ts",
      "default": "./dist/cat/index.js"
    },
    "./cat/takar": {
      "types": "./dist/cat/takar/index.d.ts",
      "default": "./dist/cat/takar/index.js"
    },
    "./caliper": {
      "types": "./dist/caliper/index.d.ts",
      "default": "./dist/caliper/index.js"
    },
    "./lti": {
      "types": "./dist/lti/index.d.ts",
      "default": "./dist/lti/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./player.css": "./player.css",
    "./pci-frame/*": "./dist/pci-frame/*",
    "./recorder-worklet.js": "./dist/recorder-worklet.js"
  },
  "files": [
    "dist",
    "src",
    "player.css",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json && node scripts/build-static.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.server.json",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only --exclude-entrypoints ./player.css ./recorder-worklet.js"
  },
  "dependencies": {
    "@luthfanwakan/olah": "workspace:^"
  },
  "peerDependencies": {
    "@luthfanwakan/takar": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@luthfanwakan/takar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@luthfanwakan/takar": "link:../../../takar/packages/takar",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "mathjax": "4.1.3",
    "requirejs": "2.3.8"
  }
}
