{
  "name": "@assesskit/runtime",
  "version": "0.0.0",
  "description": "A QTI 3.0 runtime: reads, writes, validates and executes assessment items, tests, content packages and results, with a headless delivery engine for exams on a server and practice on a device.",
  "keywords": [
    "assesskit",
    "qti",
    "qti3",
    "1edtech",
    "assessment",
    "assessment-items",
    "assessment-tests",
    "item-response-processing",
    "content-package",
    "results-reporting",
    "validator"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assesskit/assesskit.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/assesskit/assesskit/tree/main/packages/runtime#readme",
  "bugs": "https://github.com/assesskit/assesskit/issues",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "assesskit": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./asi": {
      "types": "./dist/asi/index.d.ts",
      "default": "./dist/asi/index.js"
    },
    "./cat": {
      "types": "./dist/cat/index.d.ts",
      "default": "./dist/cat/index.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "default": "./dist/delivery/index.js"
    },
    "./delivery/wire": {
      "types": "./dist/delivery/wire.d.ts",
      "default": "./dist/delivery/wire.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./interactions": {
      "types": "./dist/interactions/index.d.ts",
      "default": "./dist/interactions/index.js"
    },
    "./pci": {
      "types": "./dist/pci/index.d.ts",
      "default": "./dist/pci/index.js"
    },
    "./pnp": {
      "types": "./dist/pnp/index.d.ts",
      "default": "./dist/pnp/index.js"
    },
    "./results": {
      "types": "./dist/results/index.d.ts",
      "default": "./dist/results/index.js"
    },
    "./usage": {
      "types": "./dist/usage/index.d.ts",
      "default": "./dist/usage/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./operators": {
      "types": "./dist/operators/index.d.ts",
      "default": "./dist/operators/index.js"
    },
    "./package": {
      "types": "./dist/package/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./processing": {
      "types": "./dist/processing/index.d.ts",
      "default": "./dist/processing/index.js"
    },
    "./values": {
      "types": "./dist/values/index.d.ts",
      "default": "./dist/values/index.js"
    },
    "./xml": {
      "types": "./dist/xml/index.d.ts",
      "default": "./dist/xml/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "pnpm build && vitest bench --run --root ../.. --project 'runtime-bench*' --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@longsightgroup/qti3-core": "0.13.3",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "qti3-item-player": "1.1.20",
    "vue": "2.7.16"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "libxml2-wasm": "0.7.2",
    "saxes": "6.0.0",
    "valibot": "1.5.0",
    "xmlchars": "2.2.0"
  }
}
