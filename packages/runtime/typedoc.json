{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/checks.ts", "src/node/index.ts", "src/cli/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/assesskit/assesskit/blob/{gitRevision}/packages/runtime/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["../../docs/runtime/*.md"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "Accepted",
    "Accepts",
    "ElementOf",
    "EXPRESSION",
    "FlowSlots",
    "HtmlAccept",
    "InteractionAccept",
    "Member",
    "ModelParts",
    "NUMERIC_EXPRESSION",
    "OUTCOME_RULES",
    "RESPONSE_RULES",
    "TEMPLATE_RULES",
    "Types"
  ]
}
