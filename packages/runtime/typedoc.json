{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/checks.ts",
    "src/errors.ts",
    "src/asi/index.ts",
    "src/cat/index.ts",
    "src/content/index.ts",
    "src/delivery/index.ts",
    "src/delivery/wire.ts",
    "src/interactions/index.ts",
    "src/item-formats/index.ts",
    "src/keys/index.ts",
    "src/metadata/index.ts",
    "src/operators/index.ts",
    "src/package/index.ts",
    "src/pci/index.ts",
    "src/pnp/index.ts",
    "src/processing/index.ts",
    "src/results/index.ts",
    "src/scoring/index.ts",
    "src/usage/index.ts",
    "src/validate/index.ts",
    "src/values/index.ts",
    "src/xml/index.ts",
    "src/node/index.ts",
    "src/cli/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/assesskit/assesskit/blob/{gitRevision}/packages/runtime/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["../../docs/runtime/*.md"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "Accepted",
    "Accepts",
    "ANSWERED_STATUSES",
    "CAT_STATUSES",
    "DELIVERY_STATUSES",
    "ElementOf",
    "EXPRESSION",
    "FlowSlots",
    "HtmlAccept",
    "InteractionAccept",
    "ITEM_SESSION_STATUSES",
    "Member",
    "ModelParts",
    "MOVES",
    "NUMERIC_EXPRESSION",
    "OUTCOME_RULES",
    "OUTCOME_VIEWS",
    "RESPONSE_RULES",
    "SCORE_STATUSES",
    "SESSION_STATUSES",
    "SUPPORT_ASSIGNMENTS",
    "SUPPORT_STATES",
    "TEMPLATE_RULES",
    "Types"
  ]
}
