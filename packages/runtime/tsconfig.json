{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@assesskit/runtime": ["./src/index.ts"],
      "@assesskit/runtime/checks": ["./src/checks.ts"],
