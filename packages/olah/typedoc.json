{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/node/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/luthfanwakan/olah/blob/{gitRevision}/packages/olah/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["docs/*.md"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "Accepted",
    "Accepts",
    "ElementOf",
    "EXPRESSION",
    "FlowSlots",
    "HtmlAccept",
    "InteractionAccept",
    "Member",
    "ModelParts",
    "NUMERIC_EXPRESSION",
    "OUTCOME_RULES",
    "RESPONSE_RULES",
    "SlotMember",
    "TEMPLATE_RULES",
    "Types"
  ]
}
