{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/player/index.ts",
    "src/client/index.ts",
    "src/protocol/index.ts",
    "src/scoring/index.ts",
    "src/lti/index.ts",
    "src/cat/index.ts",
    "src/cat-rest/index.ts",
    "src/caliper/index.ts",
    "src/server/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/assesskit/assesskit/blob/{gitRevision}/packages/player/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "projectDocuments": ["../../docs/player/*.md"],
  "treatWarningsAsErrors": true
}
