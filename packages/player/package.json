{
  "name": "@assesskit/player",
  "version": "0.0.0",
  "description": "A player and integrations for QTI 3.0 assessments: rendering, the host of portable custom interactions, accessibility in the interface, and the server-side session host and computer adaptive testing, built on @assesskit/runtime.",
  "keywords": [
    "assesskit",
    "qti",
    "qti3",
    "1edtech",
    "assessment",
    "player",
    "adaptive-testing",
    "accessibility"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assesskit/assesskit.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/assesskit/assesskit/tree/main/packages/player#readme",
  "bugs": "https://github.com/assesskit/assesskit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/local": {
      "types": "./dist/client/local/index.d.ts",
      "default": "./dist/client/local/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring/index.d.ts",
      "default": "./dist/scoring/index.js"
    },
    "./cat": {
      "types": "./dist/cat/index.d.ts",
      "default": "./dist/cat/index.js"
    },
    "./cat-rest": {
      "types": "./dist/cat-rest/index.d.ts",
      "default": "./dist/cat-rest/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./messages/id": {
      "types": "./dist/messages/id/index.d.ts",
      "default": "./dist/messages/id/index.js"
    },
    "./player.css": "./player.css",
    "./pci-frame/*": "./dist/pci-frame/*",
    "./recorder-worklet.js": "./dist/recorder-worklet.js"
  },
  "files": [
    "dist",
    "src",
    "player.css",
    "NOTICE"
  ],
  "browserslist": [
    "chrome >= 111",
    "firefox >= 115",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json && node scripts/build-static.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.server.json",
    "bench": "vitest run --root ../.. --project player-bench --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only --exclude-entrypoints ./player.css ./recorder-worklet.js"
  },
  "dependencies": {
    "@assesskit/runtime": "workspace:^",
    "jose": "6.2.12",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "mathjax": "4.1.3",
    "qti3-item-player": "1.1.20",
    "requirejs": "2.3.8",
    "vue": "2.7.16"
  }
}
