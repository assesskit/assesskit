{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@assesskit/runtime": ["../runtime/src/index.ts"],
      "@assesskit/runtime/checks": ["../runtime/src/checks.ts"],
      "@assesskit/runtime/errors": ["../runtime/src/errors.ts"],
      "@assesskit/runtime/*": ["../runtime/src/*/index.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/errors.ts",
    "src/checks.ts",
    "src/messages",
    "src/protocol",
    "src/player",
    "src/client"
  ]
}
